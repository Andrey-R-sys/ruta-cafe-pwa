{
  "name": "ruta-cafe-pwa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PWA educativa de cafeterías: offline, IndexedDB, SSR, sync y Web Push.",
  "engines": { "node": ">=22.14" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "phase": "node scripts/phase.mjs",
    "icons": "node scripts/icons.mjs",
    "vapid": "node scripts/vapid.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/api.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": { "express": "^5.1.0", "web-push": "^3.6.7" },
  "devDependencies": { "@playwright/test": "^1.56.0", "sharp": "^0.34.4" }
}
